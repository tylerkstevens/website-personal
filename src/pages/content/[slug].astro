---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import ContentLayout from "../../layouts/ContentLayout.astro";
import createSlug from "../../lib/createSlug";
import { resolveMedia } from "../../lib/contentFeed";

export async function getStaticPaths() {
  const postEntries = await getCollection("posts");
  // Listing cards still open externalUrl when one is set.
  // Also render an internal page when the markdown has a writeup,
  // so /content/[slug] (and the RSS item that points at it) is not a 404.
  return postEntries
    .filter((entry) => !entry.data.externalUrl || Boolean(entry.body?.trim()))
    .map((entry) => ({
      params: { slug: createSlug(entry.data.title, entry.id) },
      props: { entry },
    }));
}

interface Props {
  entry: CollectionEntry<"posts">;
}

const { entry } = Astro.props;
const post = entry.data;
const { Content } = await render(entry);
const media = resolveMedia(entry.id, post.heroImage, post.badge, post.externalUrl);
---

<ContentLayout
  title={post.title}
  description={post.description}
  pubDate={post.pubDate}
  heroImage={media.thumbnail}
  thumbnailFit={media.thumbnailFit}
  updatedDate={post.updatedDate}
  badge={post.badge}
  tags={post.tags}
  externalUrl={post.externalUrl}
  videoUrl={media.videoUrl}
>
  <Content />
</ContentLayout>
