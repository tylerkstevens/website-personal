---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ContentCard from "../components/ContentCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug";
import { Image } from "astro:assets";

// Get most recent 3 content items (posts + appearances combined)
const posts = await getCollection("posts");
const appearances = await getCollection("appearances");

const allContent = [
  ...posts.map(p => ({
    title: p.data.title,
    description: p.data.description,
    date: p.data.pubDate,
    type: 'post' as const,
    url: `/content/${createSlug(p.data.title, p.id)}`,
    thumbnail: p.data.heroImage,
    badge: p.data.badge,
  })),
  ...appearances.map(a => ({
    title: a.data.title,
    description: a.data.description,
    date: a.data.date,
    type: a.data.type as 'talk' | 'podcast',
    url: a.data.url,
    thumbnail: a.data.thumbnail,
    badge: undefined,
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf()).slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <!-- Hero -->
  <div class="pb-12 mt-5">
    <div class="flex items-start gap-6 mb-6">
      <div class="shrink-0">
        <Image
          src="/profile.webp"
          width={80}
          height={80}
          format="webp"
          quality={90}
          alt="Tyler Stevens"
          class="rounded-full w-20 h-20 object-cover object-[50%_12%] border-2 border-base-300"
        />
      </div>
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-base-content">Tyler Stevens</h1>
        <p class="text-base-content/60 mt-0.5">Founder &amp; CEO, Exergy · Denver, CO</p>
      </div>
    </div>
    <div class="prose prose-base max-w-2xl">
      <p>
        I build things at the intersection of Bitcoin and energy. Most of my time goes into
        <a href="https://exergyheat.com" target="_blank" rel="noopener noreferrer" class="font-medium no-underline hover:underline">Exergy</a>,
        the company I founded to champion hashrate heating — turning Bitcoin miners into intelligent,
        efficient heat sources for homes and businesses. I wrote the book on it:
        <a href="https://www.amazon.com/dp/B0GYJ8QDK6" target="_blank" rel="noopener noreferrer" class="font-medium no-underline hover:underline">Bitcoin Mining Heat Reuse</a>,
        now available on Amazon.
      </p>
      <p>
        Beyond Exergy, I serve on the board of the
        <a href="https://256foundation.org" target="_blank" rel="noopener noreferrer" class="font-medium no-underline hover:underline">256 Foundation</a>
        — a nonprofit protecting open-source Bitcoin mining software and hardware.
        I founded the <a href="https://heatpunks.org" target="_blank" rel="noopener noreferrer" class="font-medium no-underline hover:underline">Hashrate Heatpunks</a>
        community, now part of the 256 Foundation, and co-founded
        <a href="https://denver.space" target="_blank" rel="noopener noreferrer" class="font-medium no-underline hover:underline">The Space</a>
        — Denver's Bitcoin citadel where the office lives and Heatpunk Summit happens each year.
      </p>
    </div>
  </div>

  <!-- What I'm working on -->
  <div class="mb-2">
    <h2 class="text-xl font-semibold tracking-tight text-base-content mb-4">What I'm working on</h2>
  </div>

  <div class="grid grid-cols-1 gap-3 mb-12">
    <ProjectCard
      logo="/logos/exergy.png"
      logoAlt="Exergy logo"
      role="Founder & CEO"
      name="Exergy"
      description="Home and business heating systems powered by hashrate. We size, design, and facilitate installation of hashrate heating solutions that offset utility costs and monetize energy for homes and businesses."
      url="https://exergyheat.com"
    />
    <ProjectCard
      logo="/logos/256foundation.png"
      logoAlt="256 Foundation logo"
      role="Board Member"
      name="256 Foundation"
      description="A nonprofit challenging proprietary control over the bitcoin mining industry. Committed to keeping bitcoin mining hardware and software open-source and accessible."
      url="https://256foundation.org"
    />
    <ProjectCard
      logo="/logos/heatpunks.png"
      logoAlt="Hashrate Heatpunks logo"
      role="Founder & Organizer"
      name="Hashrate Heatpunks"
      description="A growing community of enthusiasts and professionals who believe heat reuse is one of Bitcoin mining's most important frontiers. Now under the 256 Foundation."
      url="https://heatpunks.org"
    />
    <ProjectCard
      logo="/logos/thespace.png"
      logoAlt="The Space logo"
      role="Co-Founder"
      name="The Space"
      description="Denver's Bitcoin citadel — a member-run non-profit community hub for events, workspace, education, and the annual Heatpunk Summit."
      url="https://denver.space"
    />
    <ProjectCard
      logo="/logos/book.png"
      logoAlt="Bitcoin Mining Heat Reuse book cover"
      role="Author"
      name="Bitcoin Mining Heat Reuse"
      description="The definitive guide to hashrate heating. Now available on Amazon. I wrote this to map the emerging industry of using Bitcoin miners as intelligent heat sources."
      url="https://www.amazon.com/dp/B0GYJ8QDK6"
    />
  </div>

  <!-- Recent Content -->
  {allContent.length > 0 && (
    <div>
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-semibold tracking-tight text-base-content">Recent content</h2>
        <a href="/content" class="text-sm text-base-content/50 hover:text-base-content transition-colors">
          View all →
        </a>
      </div>
      <div class="divide-y divide-base-200">
        {allContent.map((item) => (
          <ContentCard
            title={item.title}
            description={item.description}
            date={item.date}
            type={item.type}
            url={item.url}
            thumbnail={item.thumbnail}
            badge={item.badge}
          />
        ))}
      </div>
    </div>
  )}
</BaseLayout>
