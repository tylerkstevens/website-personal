---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 — Page not found">
  <div class="flex flex-col items-center justify-center min-h-[50vh] text-center mt-10">
    <div class="text-6xl font-bold text-base-content/20 mb-4">404</div>
    <h1 class="text-2xl font-semibold text-base-content mb-2">Page not found</h1>
    <p class="text-base-content/60 mb-8">This page doesn't exist or has been moved.</p>
    <a href="/" class="btn btn-primary btn-sm">Back to home</a>
  </div>
</BaseLayout>
