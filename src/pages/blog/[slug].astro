---
import { getCollection } from "astro:content";
import createSlug from "../../lib/createSlug";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((entry) => ({
    params: { slug: createSlug(entry.data.title, entry.id) },
    props: { slug: createSlug(entry.data.title, entry.id) },
  }));
}

const { slug } = Astro.props;
const redirectTo = `/content/${slug}`;
---
<meta http-equiv="refresh" content={`0; url=${redirectTo}`} />
<script define:vars={{ redirectTo }}>window.location.replace(redirectTo);</script>
<p>Redirecting to <a href={redirectTo}>{redirectTo}</a>...</p>
