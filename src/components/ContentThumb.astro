---
interface Props {
  title: string;
  badge?: string;
  src?: string;
  fit?: 'cover' | 'contain';
  videoUrl?: string;
  featured?: boolean;
  priority?: boolean;
}

const { title, badge, src, fit = 'cover', videoUrl, featured = false, priority = false } = Astro.props;
const titleSize = featured ? 'text-2xl sm:text-4xl' : 'text-xl sm:text-2xl';
---

<div class="relative aspect-video w-full overflow-hidden bg-base-200">
  {
    src ? (
      <img
        src={src}
        alt={title}
        width="1600"
        height="900"
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={priority ? 'high' : 'auto'}
        class:list={[
          'absolute inset-0 h-full w-full',
          fit === 'contain' ? 'object-contain' : 'object-cover',
        ]}
      />
    ) : (
      <div class="absolute inset-0 bg-grid" aria-hidden="true">
        <div class="absolute inset-0 bg-gradient-to-br from-primary/10 via-transparent to-base-300/70" />
        <div class="relative flex h-full flex-col justify-end p-4 sm:p-6">
          <div class="mb-3 h-0.5 w-8 bg-primary" />
          <p class:list={['max-w-[18ch] font-semibold tracking-tight text-base-content leading-[1.05] line-clamp-4', titleSize]}>
            {title}
          </p>
        </div>
      </div>
    )
  }
  {
    badge && (
      <span class="pointer-events-none absolute top-3 left-3 z-10 font-mono text-[10px] px-1.5 py-0.5 rounded-xs border border-base-300 bg-base-100/90 text-base-content/70 tracking-wider uppercase">
        {badge}
      </span>
    )
  }
  {
    videoUrl && (
      <a
        href={videoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="absolute inset-0 z-10 flex items-center justify-center transition-colors hover:bg-neutral/30"
        aria-label={`Play video: ${title}`}
      >
        <span class="flex h-16 w-16 items-center justify-center rounded-full border border-base-300 bg-base-100/95 text-base-content shadow-sm transition-transform hover:scale-105">
          <svg class="ml-1 h-7 w-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5.14v13.72a1 1 0 0 0 1.54.84l10.14-6.86a1 1 0 0 0 0-1.68L9.54 4.3A1 1 0 0 0 8 5.14z" />
          </svg>
        </span>
      </a>
    )
  }
</div>
