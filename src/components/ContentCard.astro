---
import dayjs from "dayjs";
import ContentThumb from "./ContentThumb.astro";

export interface Props {
  title: string;
  description: string;
  date: Date;
  type: 'post' | 'talk' | 'podcast';
  url: string;
  thumbnail?: string;
  thumbnailFit?: 'cover' | 'contain';
  badge?: string;
  featured?: boolean;
  fallback?: 'quote' | 'audio';
  quote?: string;
  avatars?: { name: string; src: string }[];
}

const { title, description, date, type, url, thumbnail, thumbnailFit = 'cover', badge, featured = false, fallback, quote, avatars } = Astro.props;

const isExternal = url.startsWith('http');
const target = isExternal ? '_blank' : '_self';
const rel = isExternal ? 'noopener noreferrer' : undefined;
const formattedDate = dayjs(date).format('MMM D, YYYY');
---

<a
  href={url}
  target={target}
  rel={rel}
  data-type={type}
  class:list={[
    "content-card group flex h-full flex-col overflow-hidden rounded-md border border-base-300 bg-base-100 hover:border-base-content/30 transition-colors duration-150",
    featured && "md:col-span-2 min-[1440px]:col-span-3",
  ]}
>
  <ContentThumb
    title={title}
    badge={badge}
    src={thumbnail}
    fit={thumbnailFit}
    featured={featured}
    priority={featured}
    fallback={fallback}
    quote={quote}
    avatars={avatars}
    date={date}
  />
  <div class:list={["flex flex-1 flex-col gap-1.5", featured ? "p-5 sm:p-6" : "p-4"]}>
    <h3 class:list={[
      "font-semibold tracking-tight text-base-content leading-snug group-hover:text-primary transition-colors",
      featured ? "text-xl sm:text-2xl" : "text-base",
    ]}>
      <span>{title}</span>
      {isExternal && (
        <svg class="inline-block ml-1 mb-0.5 w-3.5 h-3.5 text-base-content/25 group-hover:text-primary/50 transition-colors" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z" />
          <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z" />
        </svg>
      )}
    </h3>
    <time class="font-mono text-[11px] tabular-nums text-base-content/45" datetime={dayjs(date).format('YYYY-MM-DD')}>{formattedDate}</time>
    <p class:list={["text-sm text-base-content/60 leading-relaxed", featured ? "line-clamp-3 max-w-3xl" : "line-clamp-2"]}>{description}</p>
  </div>
</a>
