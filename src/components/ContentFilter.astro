---
// Client-side filter tabs for the content feed
---

<div id="content-filter-tabs" class="flex gap-1 mb-6 p-1 bg-base-200 rounded-lg w-fit">
  <button
    data-filter="all"
    class="filter-tab px-4 py-1.5 rounded-md text-sm font-medium transition-colors duration-150 bg-base-100 text-base-content shadow-sm"
  >
    All
  </button>
  <button
    data-filter="post"
    class="filter-tab px-4 py-1.5 rounded-md text-sm font-medium transition-colors duration-150 text-base-content/60 hover:text-base-content"
  >
    Posts
  </button>
  <button
    data-filter="talk"
    class="filter-tab px-4 py-1.5 rounded-md text-sm font-medium transition-colors duration-150 text-base-content/60 hover:text-base-content"
  >
    Talks
  </button>
  <button
    data-filter="podcast"
    class="filter-tab px-4 py-1.5 rounded-md text-sm font-medium transition-colors duration-150 text-base-content/60 hover:text-base-content"
  >
    Podcasts
  </button>
</div>

<script>
  function initContentFilter() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
    const cards = document.querySelectorAll<HTMLElement>('.content-card');

    if (!tabs.length) return;

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const filter = tab.dataset.filter || 'all';

        // Update tab active states
        tabs.forEach(t => {
          t.classList.remove('bg-base-100', 'text-base-content', 'shadow-sm');
          t.classList.add('text-base-content/60');
        });
        tab.classList.add('bg-base-100', 'text-base-content', 'shadow-sm');
        tab.classList.remove('text-base-content/60');

        // Show/hide cards
        cards.forEach(card => {
          const cardType = card.dataset.type;
          if (filter === 'all' || cardType === filter) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContentFilter);
  } else {
    initContentFilter();
  }

  document.addEventListener('astro:page-load', initContentFilter);
</script>
