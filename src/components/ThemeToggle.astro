---
// ThemeToggle — 3-state icon button: system → light → dark → system
---

<button
  id="theme-toggle"
  class="opacity-70 hover:opacity-100 transition-opacity cursor-pointer"
  aria-label="Toggle theme"
  title="Toggle theme"
>
  <!-- Sun icon: shown when currently light → click goes dark -->
  <svg id="theme-icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
    <circle cx="12" cy="12" r="5"/>
    <line x1="12" y1="1" x2="12" y2="3"/>
    <line x1="12" y1="21" x2="12" y2="23"/>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
    <line x1="1" y1="12" x2="3" y2="12"/>
    <line x1="21" y1="12" x2="23" y2="12"/>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
  </svg>
  <!-- Moon icon: shown when currently dark → click goes system -->
  <svg id="theme-icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
  <!-- System icon: monitor → shown when currently system → click goes light -->
  <svg id="theme-icon-system" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <rect x="2" y="3" width="20" height="14" rx="2"/>
    <line x1="8" y1="21" x2="16" y2="21"/>
    <line x1="12" y1="17" x2="12" y2="21"/>
  </svg>
</button>

<script>
  function initThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    const sunIcon = document.getElementById('theme-icon-sun');
    const moonIcon = document.getElementById('theme-icon-moon');
    const systemIcon = document.getElementById('theme-icon-system');
    if (!btn || !sunIcon || !moonIcon || !systemIcon) return;

    function updateIcon() {
      const saved = localStorage.getItem('theme-preference') || 'system';
      (sunIcon as HTMLElement).style.display = 'none';
      (moonIcon as HTMLElement).style.display = 'none';
      (systemIcon as HTMLElement).style.display = 'none';
      if (saved === 'dark') {
        (moonIcon as HTMLElement).style.display = '';
      } else if (saved === 'light') {
        (sunIcon as HTMLElement).style.display = '';
      } else {
        (systemIcon as HTMLElement).style.display = '';
      }
    }

    updateIcon();

    btn.addEventListener('click', () => {
      const saved = localStorage.getItem('theme-preference') || 'system';
      const next = saved === 'system' ? 'light' : saved === 'light' ? 'dark' : 'system';
      if ((window as any).setTheme) (window as any).setTheme(next);
      updateIcon();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initThemeToggle);
  } else {
    initThemeToggle();
  }
  document.addEventListener('astro:page-load', initThemeToggle);
</script>
