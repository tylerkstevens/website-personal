---
const { title, subtitle } = Astro.props;
---

<div class="flex">
  <div class="education__time flex flex-col items-center">
    <span class="w-2.5 h-2.5 border-2 border-primary bg-base-100 block mt-1.5"></span>
    <span class="education__line bg-base-300 block h-full w-px"></span>
  </div>
  <div class="experience__data bd-grid px-5">
    <h3 class="font-semibold mb-1 leading-snug">{title}</h3>
    <span class="font-mono text-xs uppercase tracking-wider text-base-content/50">{subtitle}</span>
    <p class="my-2 text-base-content/75 text-[0.95rem] leading-relaxed">
      <slot />
    </p>
  </div>
</div>
