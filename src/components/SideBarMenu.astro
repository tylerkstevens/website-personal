---
const { sideBarActiveItemID } = Astro.props;
const activeClass = "bg-base-300 font-medium";
---

<ul class="menu grow shrink menu-md overflow-y-auto px-2">
  <li>
    <a class="py-3 text-base rounded-lg" id="home" href="/">Home</a>
  </li>
  <li>
    <a class="py-3 text-base rounded-lg" id="about" href="/about">About</a>
  </li>
  <li>
    <a class="py-3 text-base rounded-lg" id="content" href="/content">Content</a>
  </li>
  <li>
    <a class="py-3 text-base rounded-lg" id="contact" href="/contact">Contact</a>
  </li>
</ul>

<script define:vars={{ sideBarActiveItemID, activeClass }}>
  const activeItemElem = document.getElementById(sideBarActiveItemID);
  if (activeItemElem) activeItemElem.classList.add(...activeClass.split(' '));
</script>
