---
export interface Props {
  logo?: string;
  logoAlt?: string;
  role: string;
  name: string;
  description: string;
  url: string;
}

const { logo, logoAlt, role, name, description, url } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex items-start gap-4 p-5 rounded-md border border-base-300 bg-base-100 hover:bg-base-200/50 hover:border-base-content/30 hover:shadow-sm transition-colors duration-150"
>
  <div class="shrink-0 w-20 h-20 flex items-center justify-center rounded-md bg-base-200 group-hover:bg-base-300 transition-colors overflow-hidden">
    {logo ? (
      <img src={logo} alt={logoAlt || name} class="w-full h-full object-contain" />
    ) : (
      <span class="text-lg font-bold text-base-content/40">{name.charAt(0)}</span>
    )}
  </div>
  <div class="flex-1 min-w-0">
    <div class="font-mono text-[11px] text-base-content/50 uppercase tracking-[0.14em] mb-0.5">{role}</div>
    <div class="font-semibold text-base-content mb-1 leading-tight">{name}</div>
    <p class="text-sm text-base-content/70 leading-relaxed">{description}</p>
  </div>
  <div class="shrink-0 opacity-40 group-hover:opacity-100 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-primary transition-all duration-200 text-base-content/40 mt-1">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
    </svg>
  </div>
</a>
