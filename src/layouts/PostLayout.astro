---
import { type BlogSchema } from "../content/config";
import BaseLayout from "./BaseLayout.astro";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";

export interface Props extends BlogSchema {}

const { title, description, pubDate, updatedDate, heroImage, badge, tags = [] } = Astro.props;
dayjs.extend(localizedFormat);
const displayDate = dayjs(pubDate).format("ll")
import { Image } from "astro:assets";
---

<BaseLayout title={title} description={description} image={heroImage}, ogType="article">
  <main class="md:flex md:justify-center">
    <article class="prose prose-lg max-w-[750px] prose-img:mx-auto">
      {heroImage && <Image width={750} height={422} format="webp" src={heroImage} alt={title} quality={80} class="w-full mb-6 rounded-md" />}
      <h1 class="title my-2 text-4xl font-bold">{title}</h1>
      {pubDate && <time class="font-mono text-xs uppercase tracking-wider text-base-content/50">{displayDate}</time>}
      <br />
      {badge && <div class="font-mono text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded-sm border border-base-300 text-base-content/55 inline-block my-1">{badge}</div>}
      {
        tags &&
          tags.map((tag) => (
            <a href={`/blog/tag/${tag}`} class="font-mono text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded-sm border border-base-300 text-base-content/55 hover:border-base-content/40 transition-colors ml-2 no-underline">
              {tag}
            </a>
          ))
      }
      {
        updatedDate && (
          <div class="font-mono text-xs uppercase tracking-wider text-base-content/50 mt-1">
            Last updated on <time>{updatedDate}</time>
          </div>
        )
      }
      <div class="h-px bg-base-300 my-6"></div>
      <slot />
    </article>
  </main>
</BaseLayout>
